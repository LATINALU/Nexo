# ============================================================
# Nexo - Variables de entorno (copiar a .env.nexo y completar)
#   cp .env.nexo.example .env.nexo
# Generar secretos:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# ============================================================
COMPOSE_PROJECT_NAME=nexo
ENVIRONMENT=development          # development | production
DEBUG=false

# ---------- Puertos (solo se publican en 127.0.0.1) ----------
NEXO_FRONTEND_PORT=3002
NEXO_BACKEND_PORT=8002
NEXO_POSTGRES_PORT=5433
NEXO_REDIS_PORT=6380

# ---------- Seguridad (OBLIGATORIOS, min 32 chars) ----------
JWT_SECRET_KEY=
SESSION_SECRET=
ENCRYPTION_KEY=
API_SECRET_KEY=

# ---------- PostgreSQL ----------
POSTGRES_USER=nexo_user
POSTGRES_PASSWORD=
POSTGRES_DB=nexo

# ---------- Redis ----------
REDIS_PASSWORD=

# ---------- Admin inicial (si ADMIN_PASSWORD esta vacio NO se crea admin) ----------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=

# ---------- LLM (opcionales: el usuario puede usar su propia key desde la UI) ----------
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Permitir que el usuario apunte a URLs privadas/localhost (Ollama, LM Studio).
# Por defecto: true en development, false en production.
ALLOW_PRIVATE_LLM_URLS=

# ---------- Frontend ----------
NEXT_PUBLIC_VERSION=1.0.0
